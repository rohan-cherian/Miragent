# ─────────────────────────────────────────────────────────
# Miragent Scout — Environment Configuration Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to Git.
# ─────────────────────────────────────────────────────────

# Environment name — controls behaviour throughout the app
ENVIRONMENT=development

# Set to false to use real API connectors instead of mocks
# Keep true on your laptop — flip to false when you have real credentials
USE_MOCK_CONNECTORS=true

# ── Neo4j (Graph Database) ───────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=miragent_dev

# ── ClickHouse (Time-Series Events) ─────────────────────
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=miragent_dev
CLICKHOUSE_DATABASE=scout

# ── Weaviate (Vector / Semantic Search) ─────────────────
WEAVIATE_URL=http://localhost:8080

# ── Redis (Task Queue Broker) ────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Anthropic (Claude API) ───────────────────────────────
# Get yours at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Tenant Config (one per client scan) ──────────────────
TENANT_ID=acme-corp-dev
TENANT_NAME=Acme Corp (Dev)
