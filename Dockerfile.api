# Slim image for console FastAPI (W1-API-01 + W1-PLT-06 observability)
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    "fastapi>=0.111" \
    "uvicorn[standard]>=0.30" \
    "pydantic-settings>=2.0" \
    "psycopg[binary]>=3.1" \
    "opentelemetry-api>=1.27" \
    "opentelemetry-sdk>=1.27" \
    "opentelemetry-exporter-otlp-proto-http>=1.27" \
    "opentelemetry-instrumentation-fastapi>=0.48b0" \
    "opentelemetry-instrumentation-asgi>=0.48b0"

COPY scout/__init__.py ./scout/__init__.py
COPY scout/service ./scout/service
COPY scout/observability ./scout/observability

ENV PYTHONUNBUFFERED=1
ENV OTEL_SERVICE_NAME=miragent-console-api
EXPOSE 8090

CMD ["uvicorn", "scout.service.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8090"]
