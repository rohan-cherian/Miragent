# Slim image for console FastAPI skeleton (W1-API-01)
FROM python:3.12-slim

WORKDIR /app

RUN pip install --no-cache-dir \
    "fastapi>=0.111" \
    "uvicorn[standard]>=0.30" \
    "pydantic-settings>=2.0" \
    "psycopg[binary]>=3.1"

COPY scout/service ./scout/service
COPY scout/__init__.py ./scout/__init__.py

ENV PYTHONUNBUFFERED=1
EXPOSE 8090

CMD ["uvicorn", "scout.service.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8090"]
